# =============================================================================
# Copy this file to .env.local (git-ignored) and fill in real values.
# In production, set the same keys in Vercel → Project → Settings → Env Vars.
# =============================================================================

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Admin — used to gate /admin and every /api/admin/* route
ADMIN_PASSWORD=change-me-to-something-strong

# Clerk — player login. Dashboard → your app → API Keys
# The publishable key is safe to expose; the secret key must NEVER reach the client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Where Clerk sends players to sign in / sign up (these routes are scaffolded
# under app/sign-in and app/sign-up).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
